{
  "name": "memebro",
  "version": "1.0.0",
  "description": "A meme generation platform with AI-powered face-swapping",
  "private": true,
  "scripts": {
    "test:meme": "node test-meme.js",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint:js": "eslint . --ext .js --ignore-path .eslintignore",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "lint:html": "htmlhint --format unix index.html",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore-path .markdownlintignore --config .markdownlint.json",
    "lint:json": "node scripts/validate-json.js",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:markdown && npm run lint:json",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "replicate": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-jsdoc": "^63.0.1",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.2.5",
    "serve": "^14.2.6",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
