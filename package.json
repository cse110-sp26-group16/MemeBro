{
  "name": "memebro",
  "version": "1.0.0",
  "description": "A meme generation platform with AI-powered face-swapping",
  "private": true,
  "scripts": {
    "lint:js": "eslint . --ext .js --ignore-path .eslintignore",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "lint:html": "htmlhint --format unix index.html",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore-path .markdownlintignore --config .markdownlint.json",
    "lint:json": "node scripts/validate-json.js",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:markdown && npm run lint:json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-jsdoc": "^48.2.3",
    "stylelint": "^16.3.1",
    "stylelint-config-standard": "^36.0.0",
    "htmlhint": "^1.1.4",
    "markdownlint-cli": "^0.39.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
